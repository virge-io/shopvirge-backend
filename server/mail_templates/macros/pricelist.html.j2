{% set primaryColor = "#01689b" %}

{% macro bar(title, align="left") -%}
    <table class="horizontal-bar" width='100%' border='0' cellspacing='0' cellpadding='0' role='presentation' style="background-color:{{primaryColor}}; color: #fff; line-height: 1.4;">
        <tr>
            <td style="padding: 0 50px; text-align: {{ align }};" height="50">
              {{title}}
            </td>
        </tr>
    </table>
{%- endmacro %}

{% macro banner() %}
  <img class="banner-image" width="1248" height="350" style="width: 100%; height: auto;" src='cid:bannerimg' alt="Pricelist banner" border='0'/>
{% endmacro %}
