{% set title = 'Orderbevestiging #' ~ customer_order_id %}
{% set welcome_text = 'Orderbevestiging #' ~ customer_order_id %}

{% import 'macros.html.j2' as m %}
{% extends "default_layout.html.j2" %}

{% block main_padding %}20px{% endblock %}

{% block extra_styles %}
    {% set mail_audience = "customer" %}
    {# Long details stay in normal flow so the box cannot grow above the banner. #}
    {% set address_length = (customer_company_name ~ customer_name ~ customer_address ~ customer_postal_code ~ customer_city ~ customer_country ~ customer_btw_number ~ customer_email)|length %}
    {% set enable_overlap = address_length <= 160 %}
    {% include 'order_confirmation_styles.css.j2' %}
{% endblock %}

{% block header_content %}
    {% call snippets.order_header(welcome_text, "customer") %}
        {% if customer_company_name %}<strong>{{ m.breakable(customer_company_name) }}</strong><br>{% endif %}
        {% if customer_name %}{{ m.breakable(customer_name) }}<br>{% endif %}
        {% if customer_address %}{{ m.breakable(customer_address) }}<br>{% endif %}
        {% if customer_postal_code or customer_city %}{{ m.breakable(customer_postal_code) }} {{ m.breakable(customer_city) }}<br>{% endif %}
        {% if customer_country %}{{ m.breakable(customer_country) }}<br>{% endif %}

    {% endcall %}
{% endblock %}

{% block content %}
<div>

    <p style="margin-top: 0;">Beste {{ customer_name or "klant" }},</p>

    <p>Bedankt voor je bestelling bij <strong>{{ shop_name }}</strong>. Hieronder vind je een overzicht van je bestelling.</p>

    <table class="customer-order-lines" style="font-size: 14px; width: 100%; border-collapse: collapse; margin-top: 20px;">
        <thead>
            <tr style="background-color: #f5f5f5; border-bottom: 2px solid #ddd;">
                <th style="text-align: left; padding: 6px;">Product</th>
                <th style="text-align: right; padding: 6px;">Aantal</th>
                <th style="text-align: right; padding: 6px;">Prijs ex BTW</th>
                <th style="text-align: right; padding: 6px;">BTW %</th>
                <th style="text-align: right; padding: 6px;">Prijs inc BTW</th>
                <th style="text-align: right; padding: 6px;">Totaal</th>
            </tr>
        </thead>
        <tbody>
            {% for line in order_lines %}
            <tr style="border-bottom: 1px solid #eee;">
                <td style="padding: 6px;">
                    <strong>{{ line.product_name }}</strong>
                    {% if line.description %}
                    <br><small style="color: #666;">{{ line.description }}</small>
                    {% endif %}
                    {% if line.attributes %}
                    <br>
                    {% for attr in line.attributes %}
                    <small style="color: #666;">{{ attr.name }}: {{ attr.value }}{% if attr.unit %} {{ attr.unit }}{% endif %}{% if not loop.last %}, {% endif %}</small>
                    {% endfor %}
                    {% endif %}
                </td>
                <td style="text-align: right; padding: 6px;">{{ line.quantity }}</td>
                <td style="text-align: right; padding: 6px;">&euro;&nbsp;{{ "%.2f"|format(line.price_ex_btw) }}</td>
                <td style="text-align: right; padding: 6px;">{{ "%.0f"|format(line.btw_rate) }}%</td>
                <td style="text-align: right; padding: 6px;">&euro;&nbsp;{{ "%.2f"|format(line.price_inc_btw) }}</td>
                <td style="text-align: right; padding: 6px;">&euro;&nbsp;{{ "%.2f"|format(line.line_total_inc_btw) }}</td>
            </tr>
            {% endfor %}
        </tbody>
        <tfoot>
            {% if shipping_lines %}
            {% for s in shipping_lines %}
            <tr style="border-top: 2px solid #ddd;">
                <td colspan="2" style="padding: 6px;"><strong>Verzendkosten</strong></td>
                <td style="text-align: right; padding: 6px;">&euro;&nbsp;{{ "%.2f"|format(s.amount_ex_btw) }}</td>
                <td style="text-align: right; padding: 6px;">{{ "%.0f"|format(s.btw_rate) }}%</td>
                <td style="text-align: right; padding: 6px;">&euro;&nbsp;{{ "%.2f"|format(s.amount_inc_btw) }}</td>
                <td style="text-align: right; padding: 6px;">&euro;&nbsp;{{ "%.2f"|format(s.amount_inc_btw) }}</td>
            </tr>
            {% endfor %}
            {% elif shipping_fee_inc_btw is not none and shipping_fee_inc_btw > 0 %}
            <tr style="border-top: 2px solid #ddd;">
                <td colspan="5" style="text-align: right; padding: 6px;"><strong>Verzendkosten:</strong></td>
                <td style="text-align: right; padding: 6px;">&euro;&nbsp;{{ "%.2f"|format(shipping_fee_inc_btw) }}</td>
            </tr>
            {% elif shipping_fee_inc_btw is not none and shipping_fee_inc_btw == 0 %}
            <tr style="border-top: 2px solid #ddd;">
                <td colspan="5" style="text-align: right; padding: 6px;"><strong>Verzendkosten:</strong></td>
                <td style="text-align: right; padding: 6px;">Gratis</td>
            </tr>
            {% endif %}
            <tr style="border-top: 2px solid #ddd;">
                <td colspan="5" style="text-align: right; padding: 6px; font-weight: bold;">Totaal ex BTW:</td>
                <td style="text-align: right; padding: 6px;">&euro;&nbsp;{{ "%.2f"|format(total_ex_btw) }}</td>
            </tr>
            <tr>
                <td colspan="5" style="text-align: right; padding: 6px; font-weight: bold;">BTW:</td>
                <td style="text-align: right; padding: 6px;">&euro;&nbsp;{{ "%.2f"|format(total_btw) }}</td>
            </tr>
            <tr style="border-top: 1px solid #ddd;">
                <td colspan="5" style="text-align: right; padding: 6px; font-weight: bold; font-size: 18px;">Totaal inc BTW:</td>
                <td style="text-align: right; padding: 6px; font-weight: bold; font-size: 18px;">&euro;&nbsp;{{ "%.2f"|format(total_inc_btw) }}</td>
            </tr>
        </tfoot>
    </table>

    <p style="margin-top: 30px;">Besteldatum: {{ completed_at }}</p>

    <hr style="margin-top: 30px; border: none; border-top: 1px solid #ccc;">

    <p style="font-size: 12px; color: #888; margin-top: 20px; line-height: 1.5;">
        <strong>{{ shop_company }}</strong> &middot; {{ shop_address }} &middot; {{ shop_zip_code }} {{ shop_city }}<br>
        {% set contact_details = [] %}
        {% if shop_phone %}{% set _ = contact_details.append('Tel: ' ~ shop_phone) %}{% endif %}
        {% if shop_email %}{% set _ = contact_details.append('E-mail: ' ~ shop_email) %}{% endif %}
        {% if kvk_number %}{% set _ = contact_details.append('KVK: ' ~ kvk_number) %}{% endif %}
        {% if btw_number %}{% set _ = contact_details.append('BTW: ' ~ btw_number) %}{% endif %}
        {{ contact_details | join(' · ') }}
        {% if customer_btw_number %}<br>BTW-nummer klant: {{ m.breakable(customer_btw_number) }}{% endif %}
    </p>
</div>
{% endblock %}
