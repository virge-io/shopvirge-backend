# ==============================================================================
# ShopVirge Backend Environment Configuration Example (.env.example)
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ==============================================================================
# REQUIRED ENVIRONMENT VARIABLES
# Must be configured for the application to start and function properly.
# ==============================================================================

# PostgreSQL database connection URI
DATABASE_URI=postgresql://shop:shop@localhost:5432/shop

# Secret key for session management and signing tokens
SESSION_SECRET=

# AWS Cognito Authentication Settings
AWS_COGNITO_USERPOOL_ID=
AWS_COGNITO_CLIENT_ID=
AWS_COGNITO_M2M_CLIENT_ID=
AWS_COGNITO_M2M_CLIENT_SECRET=

# S3 Image Upload & CDN Configuration
S3_UPLOAD_IMAGES_BUCKET=
CLOUDFRONT_BASE=

# ==============================================================================
# OPTIONAL ENVIRONMENT VARIABLES
# Can be left unset or customized as needed. Defaults are set in server/settings.py.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application & Deployment Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=local
TESTING=true
LOG_LEVEL=DEBUG
PUBLIC_BASE_URL=http://localhost:8080
GUI_URI=http://localhost:3000
SWAGGER_HOST=localhost
SWAGGER_PORT=8080
CORS_ORIGINS=*
MCP_ENABLED=false
REVISION_RETENTION=25
SERVICE_NAME="ShopVirge Backend"

# ------------------------------------------------------------------------------
# AWS Cognito Region & Optional Clients
# ------------------------------------------------------------------------------
AWS_COGNITO_REGION=eu-central-1
AWS_COGNITO_MCP_CLIENT_ID=

# ------------------------------------------------------------------------------
# Sentry Observability
# ------------------------------------------------------------------------------
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_SAMPLE_RATE=1.0

# ------------------------------------------------------------------------------
# Database & Caching
# ------------------------------------------------------------------------------
CACHE_HOST=127.0.0.1
CACHE_PORT=6379
MAX_WORKERS=5

# ------------------------------------------------------------------------------
# Mail & Transactional Email Settings (Order & Notification Emails)
# ------------------------------------------------------------------------------
MAIL_ENABLED=true
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_STARTTLS=false
MAIL_FROM=support@shopvirge.com
MAIL_BCC=support@shopvirge.com
SHOP_MAIL_ENABLED=true

# SMTP Server Settings (Fallback / Alternative mail config)
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=no-reply@shopvirge.com
EMAILS_FROM_NAME="ShopVirge Backend"
EMAILS_CC=no-reply@shopvirge.com

# ------------------------------------------------------------------------------
# AWS S3 Storage & Lambda Credentials
# ------------------------------------------------------------------------------
S3_BUCKET_IMAGES_NAME=
S3_BUCKET_IMAGES_ACCESS_KEY_ID=
S3_BUCKET_IMAGES_SECRET_ACCESS_KEY=
S3_BUCKET_DOWNLOADS_NAME=
S3_BUCKET_TEMPORARY_NAME=
LAMBDA_ACCESS_KEY_ID=
LAMBDA_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# Stripe Test & Seed Keys (for local testing & seed scripts)
# ------------------------------------------------------------------------------
STRIPE_TEST_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_TEST_SECRET_KEY=sk_test_your_stripe_secret_key

# ------------------------------------------------------------------------------
# Initial Superuser Seed Configuration
# ------------------------------------------------------------------------------
FIRST_SUPERUSER=admin
FIRST_SUPERUSER_PASSWORD=adminpassword
FIRST_SUPERUSER_ROLE=admin
